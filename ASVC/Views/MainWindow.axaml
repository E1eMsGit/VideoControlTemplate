<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ASVC.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ASVC.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="ASVC.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Программа проверки СВК"
        FontSize="14"
        Foreground="{StaticResource SystemBaseHighColor}"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True" 
        Height="630" Width="1200" CanResize="False">
        
        <Design.DataContext>
            <vm:MainWindowViewModel />
        </Design.DataContext>

        <Grid RowDefinitions="Auto, *" >
            <Border Grid.Row="0" Height="32">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=Window }}"
                           VerticalAlignment="Center" Margin="10 0"/>
            </Border>

            <SplitView Grid.Row="1" IsPaneOpen="{Binding IsPaneOpen}"
                       OpenPaneLength="200"
                       CompactPaneLength="60"
                       DisplayMode="CompactInline"
                       Background="#1e1e1e"
                       PaneBackground="#1e1e1e">
				<SplitView.Pane>
					<StackPanel Spacing="5" Margin="5">
						
                        <Button HorizontalAlignment="Left"
                                Margin="0 10"
                                Command="{Binding TriggerPaneCommand}">
                            <Button.Content>
                                <Image Width="25" Height="25" Source="avares://ASVC/Assets/menu.png"/>
                            </Button.Content> 
                        </Button>

						<ListBox ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedListItem}">
                            
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="12 8"></Setter>
                                </Style>
                            </ListBox.Styles>

							<ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MenuItemTemplate}">
									<StackPanel Spacing="17" Orientation="Horizontal">
                                        <Image Width="25" Height="25" Source="{Binding Icon}" />
                                        <TextBlock Margin="5 0 0 0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
						</ListBox>
					</StackPanel>
				</SplitView.Pane>
                <SplitView.Content>
                    <Border CornerRadius="12 0 0 0" Background="#2d2d2d">
                        <ContentControl Content="{Binding CurrentPage}"/>
                    </Border>
                </SplitView.Content>
            </SplitView>
        </Grid>
</Window>
